# Base path of the archive API. In development this is proxied to the Spring Boot
# service by vite.config.ts; in production point it at the real gateway origin.
VITE_API_BASE_URL=/api/v1/archives
# Actuator health endpoint used by the connection indicator in the header.
VITE_HEALTH_URL=/actuator/health
# Client-side ceiling for a single request, in milliseconds.
# Keep this at or above spring.mvc.async.request-timeout on the backend.
VITE_REQUEST_TIMEOUT_MS=180000
# How many Base64 characters are ever rendered on screen.
# Rendering a full 33M-character payload freezes the tab, so previews are bounded.
VITE_MAX_PREVIEW_CHARS=4000
# Largest archive the UI will attempt to upload, in bytes (256 MB).
# Mirrors archive.limits.max-upload-bytes on the backend.
VITE_MAX_UPLOAD_BYTES=268435456